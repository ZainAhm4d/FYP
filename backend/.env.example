# FastAPI Backend Environment Variables — TEMPLATE
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# Security (REQUIRED) — generate with: openssl rand -hex 32
#   or: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-hex-secret

# ── Database ───────────────────────────────────────────────────────────────
# Local dev (default) — no setup needed, a file-based SQLite DB:
DATABASE_URL=sqlite:///./app.db
#
# Production (Supabase Postgres) — replace the line above with your Supabase
# connection string instead. To get it:
#   1. supabase.com → your project → Project Settings (gear icon) → Database
#   2. Under "Connection string", pick the "Session pooler" tab (NOT
#      "Direct connection" — the direct connection isn't reachable from most
#      hosts like Render/Railway, which don't support IPv6-only egress).
#   3. Copy the URI, select "URI" format, and substitute your database
#      password (the one you set when creating the project — Supabase shows
#      the string with [YOUR-PASSWORD] as a literal placeholder to replace).
#   4. Paste it here (or as the DATABASE_URL env var in Render/Railway).
# Both "postgres://" and "postgresql://" schemes work — the app rewrites
# postgres:// automatically (see app/core/database.py) since Supabase hands
# out the former but SQLAlchemy/psycopg2 require the latter.
#
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── CORS (production only) ────────────────────────────────────────────────
# Comma-separated, no spaces. Local dev works without setting this (see
# app/core/config.py for the built-in localhost defaults). Set this once
# your frontend is deployed to Vercel:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=AI-Driven BI Dashboard Generator

# JWT Token Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
# ⚠ On Render's free tier and Railway without an attached volume, this
# directory is EPHEMERAL — uploaded/cleaned files are wiped on every
# redeploy and on free-tier spin-down. Fine for a demo, not for real data.
# See DEPLOYMENT.md "File storage is not persistent" for the real fix.

# OpenRouter LLM (OPTIONAL — enables enhanced natural-language parsing).
# Leave both keys blank to run the offline keyword NLP engine instead.
# Get free keys at openrouter.ai (Settings → API Keys, one per account).

# Primary key — always tried first.
OPENROUTER_API_KEY=sk-or-v1-your-first-key-here

# OPTIONAL: extra keys from other accounts, comma-separated, no spaces.
# When the primary key hits its rate limit or runs out of credit, requests
# automatically fail over to the next key here instead of making the user
# wait — see backend/app/services/nlp/llm_parser.py (_KeyPool). Leave this
# line blank/commented to use only OPENROUTER_API_KEY (single-key mode).
# OPENROUTER_API_KEYS=sk-or-v1-your-second-key,sk-or-v1-your-third-key

OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ── Scheduled Email Reports (OPTIONAL) ────────────────────────────────────────
# If no provider is configured, emails are logged to console only (dry-run).
# Priority: Resend → SendGrid → SMTP → dry-run

# Option A — Resend (recommended · 3 000 free emails/month · resend.com)
# 1. Sign up at resend.com → create an API key
# 2. Add and verify your sending domain (or use the onboarding@resend.dev sandbox)
RESEND_API_KEY=
REPORT_FROM_EMAIL=you@yourdomain.com

# Option B — SendGrid (100 free emails/day · sendgrid.com)
SENDGRID_API_KEY=

# Option C — Gmail SMTP App Password
# Go to myaccount.google.com → Security → App Passwords to generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# ── Admin portal (CH-18) ──────────────────────────────────────────────────────
# When both are set, a superadmin account is created at startup (idempotent).
# Log in with these credentials at admin.html. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!
# Days a deleted account stays recoverable before rows + files are purged
ADMIN_USER_RETENTION_DAYS=30
